# =============================================================================
# LetsNormalizeIt Backend Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment

# =============================================================================
# Server Configuration
# =============================================================================
LNI_SERVER_PORT=8080
LNI_SERVER_ALLOW_ORIGINS=*

# =============================================================================
# Authentication Configuration
# =============================================================================
# Auth type: jwt or firebase
LNI_AUTH_TYPE=jwt

# JWT Configuration (when LNI_AUTH_TYPE=jwt)
# IMPORTANT: Change this secret in production!
LNI_JWT_SECRET=your-super-secret-key-change-in-production
# JWT access token expiry (e.g., 24h, 1h, 30m)
LNI_JWT_EXPIRY=24h
# JWT refresh token expiry (e.g., 168h for 7 days)
LNI_JWT_REFRESH_EXPIRY=168h

# Firebase Configuration (when LNI_AUTH_TYPE=firebase)
LNI_FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json
LNI_FIREBASE_PROJECT_ID=your-firebase-project-id

# =============================================================================
# MongoDB Configuration
# =============================================================================
LNI_MONGODB_URI=mongodb://localhost:27017
LNI_MONGODB_DATABASE=letsnormalizeit

# =============================================================================
# Redis Configuration (Optional - for caching)
# =============================================================================
LNI_REDIS_ADDRESS=localhost:6379
LNI_REDIS_PASSWORD=
LNI_REDIS_DB=0

# =============================================================================
# Cache Configuration
# =============================================================================
# Enable/disable caching (true/false)
LNI_CACHE_ENABLED=true
# Cache type: memory or redis
LNI_CACHE_TYPE=memory

# =============================================================================
# Logger Configuration
# =============================================================================
LNI_LOGGER_LEVEL=info
LNI_LOGGER_ENCODING=json
